<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.settings.SettingsFragment">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/barriers_icon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:src="@drawable/ic_barrier_24dp"
        app:tint="?android:attr/textColorPrimary"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/barriers_label"
        app:layout_constraintBottom_toBottomOf="@id/barriers_label" />

    <TextView
        android:id="@+id/barriers_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:text="@string/settings_barriers_label"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/barriers_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/barriers_reload_button"
        android:layout_width="@dimen/icon_size_medium"
        android:layout_height="@dimen/icon_size_medium"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_reload_content_description"
        android:src="@drawable/ic_reload_black_24dp"
        app:layout_constraintStart_toEndOf="@id/barriers_label"
        app:layout_constraintTop_toTopOf="@id/barriers_label"
        app:layout_constraintBottom_toBottomOf="@id/barriers_label" />

    <TextView
        android:id="@+id/shortcut_notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/errorColor"
        android:textSize="@dimen/text_size_medium"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barriers_label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/barriers_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="100dp"
        android:nestedScrollingEnabled="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shortcut_notice" />

    <ImageView
        android:id="@+id/doors_icon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:src="@drawable/ic_door_24dp"
        app:tint="?android:attr/textColorPrimary"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/doors_label"
        app:layout_constraintBottom_toBottomOf="@id/doors_label" />

    <TextView
        android:id="@+id/doors_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:text="@string/settings_doors_label"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/doors_icon"
        app:layout_constraintTop_toBottomOf="@id/barriers_recycler_view" />

    <ImageButton
        android:id="@+id/doors_reload_button"
        android:layout_width="@dimen/icon_size_medium"
        android:layout_height="@dimen/icon_size_medium"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_reload_content_description"
        android:src="@drawable/ic_reload_black_24dp"
        app:layout_constraintStart_toEndOf="@id/doors_label"
        app:layout_constraintTop_toTopOf="@id/doors_label"
        app:layout_constraintBottom_toBottomOf="@id/doors_label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/doors_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="100dp"
        android:nestedScrollingEnabled="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/doors_label" />

    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/barriers_recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/barriers_recycler_view" />

    <TextView
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="?attr/errorColor"
        app:layout_constraintBottom_toBottomOf="@id/barriers_recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/barriers_recycler_view" />

    <TextView
        android:id="@+id/barriers_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_barriers_empty"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/barriers_recycler_view"
        app:layout_constraintStart_toStartOf="@id/barriers_recycler_view"
        app:layout_constraintTop_toTopOf="@id/barriers_recycler_view" />

    <TextView
        android:id="@+id/doors_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_doors_empty"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/doors_recycler_view"
        app:layout_constraintStart_toStartOf="@id/doors_recycler_view"
        app:layout_constraintTop_toTopOf="@id/doors_recycler_view" />

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
