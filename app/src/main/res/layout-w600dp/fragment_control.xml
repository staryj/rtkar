<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    tools:context=".ui.control.ControlFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_control"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No devices available"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recycler_view_control"
        app:layout_constraintEnd_toEndOf="@id/recycler_view_control"
        app:layout_constraintStart_toStartOf="@id/recycler_view_control"
        app:layout_constraintTop_toTopOf="@id/recycler_view_control" />

</androidx.constraintlayout.widget.ConstraintLayout>
