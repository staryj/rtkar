<resources>
    <!-- Base application theme. -->
    <style name="Theme.RTKar" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/header_background</item>
        <item name="colorPrimaryVariant">@color/status_bar</item>
        <item name="colorOnPrimary">@color/header_text</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/button_secondary</item>
        <item name="colorSecondaryVariant">@color/background_secondary</item>
        <item name="colorOnSecondary">@color/button_secondary_text</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/status_bar</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Card colors -->
        <item name="cardBackgroundActive">@color/card_background_active</item>
        <item name="cardStrokeActive">@color/card_stroke_active</item>
        <item name="cardBackgroundLoading">@color/card_background_loading</item>
        <item name="cardStrokeLoading">@color/card_stroke_loading</item>
        <item name="cardBackgroundInactive">@color/card_background_inactive</item>
        <item name="cardStrokeInactive">@color/card_stroke_inactive</item>
        <item name="cardBackgroundSelected">@color/card_background_selected</item>
        <item name="cardStrokeSelected">@color/card_stroke_selected</item>
        
        <!-- Error and action colors -->
        <item name="errorColor">@color/error_color</item>
        <item name="deleteButtonColor">@color/delete_button_color</item>
        
        <!-- Navigation bar colors -->
        <item name="bottomNavigationStyle">@style/Widget.RTKar.BottomNavigationView</item>
        <item name="navigationViewStyle">@style/Widget.RTKar.NavigationView</item>
        
        <!-- Customize your theme here. -->
    </style>
    
    <style name="Widget.RTKar.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/nav_bar_background</item>
        <item name="itemIconTint">@color/nav_bar_icon_color_selector</item>
        <item name="itemTextColor">@color/nav_bar_text_color_selector</item>
        <item name="itemRippleColor">@color/nav_bar_item_text_selected</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.RTKar.BottomNavigation.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.RTKar.BottomNavigation.Inactive</item>
    </style>
    
    <style name="TextAppearance.RTKar.BottomNavigation.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>
    
    <style name="TextAppearance.RTKar.BottomNavigation.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

    <style name="Theme.RTKar.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.RTKar.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="titleTextAppearance">@style/TextAppearance.RTKar.Toolbar.Title</item>
    </style>
    
    <style name="TextAppearance.RTKar.Toolbar.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">@dimen/text_size_large</item>
    </style>

    <style name="Theme.RTKar.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    
    <!-- Navigation Drawer Style -->
    <style name="Widget.RTKar.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="itemIconTint">@color/nav_drawer_icon_color_selector</item>
        <item name="itemTextColor">@color/nav_drawer_text_color_selector</item>
        <item name="itemBackground">@drawable/nav_drawer_item_background_selector</item>
        <item name="android:background">@color/nav_drawer_background</item>
        <item name="itemTextAppearance">@style/TextAppearance.RTKar.NavigationDrawer</item>
    </style>
    
    <style name="TextAppearance.RTKar.NavigationDrawer" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>
</resources>