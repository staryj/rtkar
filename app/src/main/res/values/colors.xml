<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================ -->
    <!-- PRIMARY BRAND COLORS -->
    <!-- ============================================ -->
    <color name="purple_dark">#1a1125</color> <!-- Background -->
    <color name="purple_avg_1">#30293b</color> <!-- Background light -->
    <color name="purple_avg_2">#332a41</color> <!-- Background cards -->
    <color name="purple_avg_3">#3c2e52</color> <!-- Background buttons -->
    <color name="purple_light_1">#8b63fe</color> <!-- Actions -->
    <color name="purple_light_2">#7b6f98</color> <!-- Inactive -->
    <color name="purple_light_3">#e6d9f5</color> <!-- Titles -->
    <color name="green_dark">#2e5956</color> <!-- Active card background -->
    <color name="green_light">#57d9b7</color> <!-- Active action -->
    
    <!-- ============================================ -->
    <!-- BASIC COLORS -->
    <!-- ============================================ -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="red">#F44336</color>

    <!-- ============================================ -->
    <!-- BACKGROUND COLORS -->
    <!-- ============================================ -->
    <color name="background_primary">@color/purple_dark</color>
    <color name="background_secondary">@color/purple_avg_1</color>
    
    <!-- ============================================ -->
    <!-- HEADER/TOOLBAR COLORS -->
    <!-- ============================================ -->
    <color name="header_background">@color/purple_avg_1</color>
    <color name="header_text">@color/purple_light_3</color>
    <color name="status_bar">@color/purple_avg_1</color>
    
    <!-- ============================================ -->
    <!-- TEXT COLORS -->
    <!-- ============================================ -->
    <color name="text_primary">@color/purple_light_1</color>
    <color name="text_secondary">@color/purple_light_1</color>
    <color name="text_on_primary">@color/purple_light_2</color>
    <color name="text_on_secondary">@color/purple_light_2</color>
    
    <!-- ============================================ -->
    <!-- CARD COLORS -->
    <!-- ============================================ -->
    <color name="card_background_active">@color/purple_avg_2</color>
    <color name="card_stroke_active">@color/purple_dark</color>
    <color name="card_background_loading">@color/green_dark</color>
    <color name="card_stroke_loading">@color/purple_dark</color>
    <color name="card_background_inactive">@color/purple_light_2</color>
    <color name="card_stroke_inactive">@color/purple_dark</color>
    <color name="card_background_selected">@color/green_dark</color>
    <color name="card_stroke_selected">@color/purple_dark</color>
    
    <!-- Card content colors (text and icon) based on state -->
    <color name="card_content_active">@color/purple_light_3</color>
    <color name="card_content_loading">@color/green_light</color>
    <color name="card_content_inactive">@color/purple_light_3</color>
    <color name="card_content_selected">@color/purple_light_3</color>
    
    <!-- ============================================ -->
    <!-- BUTTON COLORS -->
    <!-- ============================================ -->
    <color name="button_primary">@color/purple_avg_3</color>
    <color name="button_primary_text">@color/purple_light_1</color>
    <color name="button_secondary">@color/purple_avg_3</color>
    <color name="button_secondary_text">@color/purple_light_1</color>
    <color name="delete_button_color">@color/red</color>
    <color name="delete_button_text">@color/white</color>
    <color name="reload_button_loading">@color/green_light</color>
    <color name="icon_button_tint">@color/white</color>
    
    <!-- ============================================ -->
    <!-- ICON COLORS -->
    <!-- ============================================ -->
    <color name="icon_primary">@color/purple_light_1</color>
    <color name="icon_secondary">@color/purple_light_1</color>
    <color name="icon_on_primary">@color/green_light</color>
    <color name="icon_control">@color/green_light</color>
    
    <!-- ============================================ -->
    <!-- ERROR AND ACTION COLORS -->
    <!-- ============================================ -->
    <color name="error_color">@color/red</color>
    
    <!-- ============================================ -->
    <!-- NAVIGATION BAR COLORS (Bottom Navigation) -->
    <!-- ============================================ -->
    <color name="nav_bar_background">@color/purple_avg_1</color>
    <color name="nav_bar_item_text_selected">@color/green_light</color>
    <color name="nav_bar_item_text_unselected">@color/purple_light_1</color>
    <color name="nav_bar_icon_selected">@color/green_light</color>
    <color name="nav_bar_icon_unselected">@color/purple_light_1</color>
    
    <!-- ============================================ -->
    <!-- NAVIGATION DRAWER COLORS (Left Sidebar) -->
    <!-- ============================================ -->
    <color name="nav_drawer_background">@color/purple_avg_1</color>
    <color name="nav_drawer_header_background">@color/purple_dark</color>
    <color name="nav_drawer_item_text_selected">@color/purple_light_3</color>
    <color name="nav_drawer_item_text_unselected">@color/purple_light_1</color>
    <color name="nav_drawer_icon_selected">@color/purple_light_3</color>
    <color name="nav_drawer_icon_unselected">@color/purple_light_1</color>
    <color name="nav_drawer_item_background_selected">@color/purple_avg_2</color>
    <color name="nav_drawer_item_background">@android:color/transparent</color>
    
    <!-- ============================================ -->
    <!-- LAUNCHER COLORS -->
    <!-- ============================================ -->
    <color name="launcher_background">@color/purple_dark</color>
</resources>